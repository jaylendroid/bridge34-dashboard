# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase API (for backend sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-service-role-key

# Google Calendar API - Service Account Authentication
# Format: Base64 encoded JSON service account key
GOOGLE_CALENDAR_SERVICE_ACCOUNT=your-service-account-json-base64-encoded

# Legacy: Google Calendar API (for Vercel serverless function)
GOOGLE_OAUTH_TOKEN=your-oauth-token
